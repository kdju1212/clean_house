generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  COMPANY
  ADMIN
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PhotoType {
  MAIN
  WORK
  BEFORE_AFTER
}

enum ReservationStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ReportTargetType {
  REVIEW
}

enum ReportStatus {
  PENDING
  RESOLVED
}

enum NotificationType {
  RESERVATION_REQUESTED
  RESERVATION_ACCEPTED
  RESERVATION_REJECTED
  RESERVATION_CANCELLED
  RESERVATION_COMPLETED
  CHAT_MESSAGE
  REVIEW_REQUEST
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  company      Company?
  reservations  Reservation[]
  chatMessages  ChatMessage[]
  reviews       Review[]
  reports       Report[]
  notifications Notification[]
  favorites     Favorite[]
}

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  order Int    @default(0)

  services       CompanyService[]
  reservations   Reservation[]
  advertisements Advertisement[]
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())

  companies CompanyRegion[]
}

model Company {
  id            String        @id @default(cuid())
  ownerUserId   String        @unique
  name          String
  phone         String?
  introText     String?
  mainImageUrl  String?
  businessHours String?
  isAvailable   Boolean       @default(true)
  status        CompanyStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  owner        User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  services     CompanyService[]
  photos       CompanyPhoto[]
  regions      CompanyRegion[]
  reservations   Reservation[]
  reviews        Review[]
  favoritedBy    Favorite[]
  advertisements Advertisement[]
}

model CompanyService {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String
  price       Int
  description String?
  createdAt   DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([companyId, categoryId])
}

model CompanyPhoto {
  id        String    @id @default(cuid())
  companyId String
  url       String
  type      PhotoType @default(WORK)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyRegion {
  companyId String
  regionId  String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  region  Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([companyId, regionId])
}

model Reservation {
  id            String            @id @default(cuid())
  customerId    String
  companyId     String
  categoryId    String
  customerName  String
  customerPhone String
  address       String
  addressDetail String?
  desiredDate   DateTime          @db.Date
  desiredTime   String
  requestNote   String?
  price         Int?
  status        ReservationStatus @default(REQUESTED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  chatRoom ChatRoom?
  review   Review?
}

model ChatRoom {
  id            String   @id @default(cuid())
  reservationId String   @unique
  createdAt     DateTime @default(now())

  reservation Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
}

model ChatMessage {
  id         String   @id @default(cuid())
  chatRoomId String
  senderId   String
  content    String
  imageUrl   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Review {
  id            String   @id @default(cuid())
  reservationId String   @unique
  companyId     String
  customerId    String
  rating        Int
  content       String
  photoUrl      String?
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

/// targetId is a loose reference (no DB-level FK) since it can point at
/// different target types as reporting expands beyond reviews.
model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  companyId  String
  createdAt  DateTime @default(now())

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([customerId, companyId])
}

/// CPT(기간) 광고. status는 저장하지 않고 cancelled + startDate/endDate로
/// 항상 그 시점 상태(예정/진행중/종료/취소)를 계산한다 — 별도 배치 작업
/// 없이도 상태가 stale해지지 않는다. 초기 버전은 실제 결제를 붙이지 않고
/// 데이터 구조와 노출 로직만 구현한다.
model Advertisement {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String
  slot        Int
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  pricePerDay Int
  cancelled   Boolean  @default(false)
  createdAt   DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, slot, startDate, endDate])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
