generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  COMPANY
  ADMIN
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// WORK and TEMPLATE are the two separate photo sets behind the
/// "상세페이지" section — one per DetailPageMode — so switching modes never
/// mixes a prepared banner image into template photos or vice versa.
enum PhotoType {
  MAIN
  WORK
  BEFORE_AFTER
  TEMPLATE
}

/// Which photo set the public "상세페이지" section shows. CUSTOM_IMAGE shows
/// WORK photos stacked edge-to-edge (a company's own prepared tall image);
/// SITE_TEMPLATE shows TEMPLATE photos with a caption block after each, for
/// a company that just has ordinary photos and wants the site to lay them out.
enum DetailPageMode {
  CUSTOM_IMAGE
  SITE_TEMPLATE
}

enum ReservationStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  // Company marks this after the scheduled date/time when the customer
  // never showed up — only reachable from ACCEPTED, same as COMPLETED.
  NO_SHOW
}

enum ReportTargetType {
  REVIEW
}

enum ReportStatus {
  PENDING
  RESOLVED
}

enum RegionLevel {
  SIDO // 시/도
  SIGUNGU // 시/군/구
  EUPMYEONDONG // 읍/면/동
}

enum NotificationType {
  RESERVATION_REQUESTED
  RESERVATION_ACCEPTED
  RESERVATION_REJECTED
  RESERVATION_CANCELLED
  RESERVATION_COMPLETED
  RESERVATION_NO_SHOW
  CHAT_MESSAGE
  REVIEW_REQUEST
}

/// FLAT: `price` is the whole job's price, same for everyone.
/// PER_UNIT: `price` is a per-unit rate (평당/대당) multiplied by whatever
/// the category's quantity question comes out to (see
/// src/lib/reservation-questions.ts's pricingQuantityKey) to estimate a
/// customer-specific price on the listing page — only offered for
/// categories that actually have such a question (에어컨청소's 대수,
/// 입주청소 등의 평수); categories without one (세탁기청소) stay FLAT-only.
enum PricingUnit {
  FLAT
  PER_UNIT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  phone         String?
  // The mobile app's Expo push token — single value is enough for the MVP
  // (same simplicity tradeoff as the mobile auth token: one device at a
  // time, overwritten on the next login/app start rather than tracked
  // per-device). Null for anyone who has only ever used the web app.
  pushToken     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  company      Company?
  reservations  Reservation[]
  chatMessages  ChatMessage[]
  reviews       Review[]
  reports       Report[]
  notifications Notification[]
  favorites     Favorite[]
  categoryProfiles CategoryProfile[]
}

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  order Int    @default(0)

  services         CompanyService[]
  reservationItems ReservationItem[]
  advertisements   Advertisement[]
  categoryProfiles CategoryProfile[]
  photos         CompanyPhoto[]
}

/// A customer's saved answers for one category's reservation questions
/// (see reservation-questions.ts) — reused across every company's listing
/// in that category (to estimate a PER_UNIT price) and to pre-fill the
/// reservation form, instead of asking again every time. Separate from
/// ReservationItem.categoryAnswers, which is an immutable snapshot of what
/// was answered for one specific booking.
model CategoryProfile {
  id         String   @id @default(cuid())
  customerId String
  categoryId String
  answers    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([customerId, categoryId])
}

/// Self-referencing so the same table covers 시/도 -> 시/군/구 -> 읍/면/동
/// without a second region table. parentId is nullable (SIDO has none),
/// and existing rows created before this hierarchy (level defaults to
/// EUPMYEONDONG, parentId null) keep working exactly as before — they're
/// just leaves with no parent, same as any other leaf.
///
/// Note: @@unique([parentId, name]) doesn't stop two NULL-parent rows from
/// sharing a name (Postgres treats each NULL as distinct in a unique
/// index) — acceptable here since top-level rows only ever come from the
/// seed script, not user input.
model Region {
  id        String      @id @default(cuid())
  name      String
  level     RegionLevel @default(EUPMYEONDONG)
  parentId  String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())

  parent    Region?         @relation("RegionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Region[]        @relation("RegionHierarchy")
  companies CompanyRegion[]

  @@unique([parentId, name])
  @@index([parentId])
}

model Company {
  id            String        @id @default(cuid())
  ownerUserId   String        @unique
  name          String
  phone         String?
  introText     String?
  mainImageUrl  String?
  businessHours String?
  isAvailable   Boolean       @default(true)
  status        CompanyStatus @default(PENDING)
  // Collected once at registration (see company/register/register-form.tsx)
  // so an admin has something to check before flipping isVerified — nullable
  // because companies registered before this field existed have neither.
  // Digits only (dashes stripped) so "123-45-67890" and "1234567890" can't
  // collide as "different" businesses. @unique still allows any number of
  // NULLs in Postgres, so pre-existing rows don't conflict with each other.
  businessRegistrationNumber String? @unique
  representativeName         String?
  // A company's own booking site — when set, "예약하기" sends the customer
  // there instead of into our own reservation flow (see ServiceBar on the
  // web repo and the detail screen's stickyBar on the app). We're a
  // directory/matching site, not a payment processor, so a company that
  // already handles booking (and payment) on its own site keeps doing so.
  websiteUrl                 String?
  // Set by an admin after checking the business registration off-platform
  // — never self-service, see admin/companies/actions.ts. Shown as a badge
  // wherever the company is listed, purely a trust signal (no automated
  // check backs it).
  isVerified    Boolean       @default(false)
  // Which layout the "상세페이지" section (WORK photos) uses — see
  // DetailPageMode. Defaults to the original stacked-image behavior so
  // every existing company keeps looking exactly as it did before this
  // field existed.
  detailPageMode DetailPageMode @default(CUSTOM_IMAGE)
  /// Regular weekly days off (0=일 … 6=토), on top of the one-off
  /// CompanyBlockedDate rows — e.g. [1] for "매주 월요일 휴무".
  closedWeekdays Int[]         @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  owner        User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  services     CompanyService[]
  photos       CompanyPhoto[]
  regions      CompanyRegion[]
  reservations   Reservation[]
  reviews        Review[]
  favoritedBy    Favorite[]
  advertisements Advertisement[]
  blockedDates   CompanyBlockedDate[]
}

/// A single calendar day this company doesn't take reservations on (휴무일) —
/// separate from Company.isAvailable, which is an all-or-nothing "예약 가능/
/// 마감" toggle. Checked both when a customer submits a new reservation
/// (see createReservationForCustomer) and shown as a hint on the booking
/// form so they don't pick one in the first place.
model CompanyBlockedDate {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
}

model CompanyService {
  id          String      @id @default(cuid())
  companyId   String
  categoryId  String
  price       Int
  pricingUnit PricingUnit @default(FLAT)
  description String?
  createdAt   DateTime    @default(now())
  // Which options this company handles for each select-type reservation
  // question of this category (see src/lib/reservation-questions.ts),
  // keyed by question key — e.g. {"type": ["벽걸이형", "스탠드형"]}. A
  // missing key (including every existing row before this field existed)
  // means "no restriction" for that question, so a company never
  // disappears from search just because it hasn't set this.
  supportedOptions Json?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([companyId, categoryId])
}

model CompanyPhoto {
  id        String    @id @default(cuid())
  companyId String
  url       String
  type      PhotoType @default(WORK)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  // Which of the company's categories this photo belongs to (WORK/
  // BEFORE_AFTER only — MAIN stays company-wide) — null means "shown for
  // every category", so a company that never bothers tagging anything
  // (or just wants one shared photo) keeps working exactly as before.
  categoryId String?
  // Short caption shown under this photo when the company's
  // detailPageMode is SITE_TEMPLATE — ignored in CUSTOM_IMAGE mode.
  caption String?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model CompanyRegion {
  companyId String
  regionId  String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  region  Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([companyId, regionId])
}

/// One visit: a single address/date/time, chat room, review and status,
/// covering one or more of the company's services (items) — e.g. 입주청소 +
/// 에어컨청소 booked together is one Reservation with two items.
model Reservation {
  id            String            @id @default(cuid())
  customerId    String
  companyId     String
  customerName  String
  customerPhone String
  address       String
  addressDetail String?
  desiredDate   DateTime          @db.Date
  desiredTime   String
  requestNote   String?
  // Total for the visit — starts as the sum of the items' listed prices and
  // is overwritten with the company's actual quote when it accepts.
  price         Int?
  status        ReservationStatus @default(REQUESTED)
  // Set when the company marks it COMPLETED — the review reminder job
  // (src/lib/review-reminder.ts) counts from here rather than updatedAt.
  completedAt          DateTime?
  // At most one follow-up "리뷰를 기다리고 있어요" nudge per reservation.
  reviewReminderSentAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  customer User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items    ReservationItem[]
  chatRoom ChatRoom?
  review   Review?
}

model ReservationItem {
  id            String   @id @default(cuid())
  reservationId String
  categoryId    String
  // Category-specific quote details (e.g. 에어컨청소's 형태/대수, 이사청소's
  // 평수) — see src/lib/reservation-questions.ts for what's asked per
  // category. A plain {key: value} object, or null for a category with no
  // extra questions defined.
  categoryAnswers Json?
  // The service's listed price at booking time.
  price         Int?
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id])

  @@unique([reservationId, categoryId])
}

model ChatRoom {
  id            String   @id @default(cuid())
  reservationId String   @unique
  createdAt     DateTime @default(now())

  reservation Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
}

model ChatMessage {
  id         String   @id @default(cuid())
  chatRoomId String
  senderId   String
  content    String
  imageUrl   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
}

model Review {
  id            String   @id @default(cuid())
  reservationId String   @unique
  companyId     String
  customerId    String
  rating        Int
  content       String
  // Kept only so a review written before ReviewPhoto existed still has its
  // one photo — never set for a new review anymore (see createReviewForUser),
  // which writes into `photos` instead so more than one is possible. Every
  // display path reads `photos`, falling back to this for old rows with an
  // empty `photos` list.
  photoUrl      String?
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())

  reservation Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  photos      ReviewPhoto[]
}

model ReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

/// targetId is a loose reference (no DB-level FK) since it can point at
/// different target types as reporting expands beyond reviews.
model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  companyId  String
  createdAt  DateTime @default(now())

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([customerId, companyId])
}

/// CPT(기간) 광고. status는 저장하지 않고 cancelled + startDate/endDate로
/// 항상 그 시점 상태(예정/진행중/종료/취소)를 계산한다 — 별도 배치 작업
/// 없이도 상태가 stale해지지 않는다. 초기 버전은 실제 결제를 붙이지 않고
/// 데이터 구조와 노출 로직만 구현한다.
model Advertisement {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String
  slot        Int
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  pricePerDay Int
  cancelled   Boolean  @default(false)
  createdAt   DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, slot, startDate, endDate])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
