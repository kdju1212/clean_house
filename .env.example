# 이 파일은 "로컬 개발환경"용입니다. cp .env.example .env 로 복사해서 채우세요.
# .env는 .gitignore에 포함되어 있어 커밋되지 않습니다.
#
# 배포(Vercel) 환경변수는 이 파일과 완전히 분리되어 있습니다 — Vercel 프로젝트
# 설정 → Environment Variables에 운영용 값을 따로 등록하고, 로컬 .env에는 절대
# 운영 DB/시크릿을 넣지 마세요. 로컬과 배포가 같은 키(OAuth 앱, Cloudinary 계정)를
# 공유해도 되지만, DATABASE_URL만큼은 반드시 로컬 전용 DB를 가리키게 하세요
# (운영 DB에 로컬에서 직접 붙어서 마이그레이션/시드를 돌리면 실제 데이터가 손상될 수 있음).

# PostgreSQL connection (docker-compose local dev shown below)
DATABASE_URL="postgresql://clean_house:clean_house@localhost:5432/clean_house?schema=public"

# 배포(Neon 등 커넥션 풀러를 쓰는 호스팅) 전용 — 마이그레이션(prisma migrate
# deploy)은 세션 단위 advisory lock이 필요해서 풀러(호스트에 "-pooler")를 거치면
# 타임아웃(P1002)이 납니다. DATABASE_URL과 똑같은 값에서 "-pooler"만 뺀 direct
# 연결 문자열을 여기 넣어주세요 (Neon 콘솔 → Connection Details → "Pooled
# connection" 토글 끄면 나오는 값). 로컬 개발(DATABASE_URL이 이미 direct)에서는
# 비워두면 됩니다 — 없으면 DATABASE_URL을 그대로 씁니다.
DIRECT_DATABASE_URL=""

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# 로컬/배포 둘 다 각자 생성한 값을 쓰세요 (공유하지 않아도 됨).
AUTH_SECRET=""

# Google OAuth (https://console.developers.google.com/apis/credentials)
# 콘솔의 Redirect URI 목록에 아래 두 개를 함께 등록해두면 앱/키 하나를
# 로컬과 배포 양쪽에서 공용으로 씁니다.
#   http://localhost:3000/api/auth/callback/google   (로컬)
#   https://<배포-도메인>/api/auth/callback/google    (배포)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Kakao OAuth (https://developers.kakao.com/console/app)
#   http://localhost:3000/api/auth/callback/kakao
#   https://<배포-도메인>/api/auth/callback/kakao
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# Naver OAuth (https://developers.naver.com/apps)
#   http://localhost:3000/api/auth/callback/naver
#   https://<배포-도메인>/api/auth/callback/naver
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# Kakao REST API 키 (GPS -> 법정동 변환, "내 위치로 찾기") — Kakao OAuth 로그인 키와는
# 다른 키입니다. https://developers.kakao.com/console/app 에서 앱 선택 → 앱 키 →
# REST API 키를 복사하고, 좌측 메뉴 제품 설정 → 카카오맵에서 활성화만 해두면 됩니다
# (플랫폼 도메인 등록은 서버 사이드 호출이라 필요 없어요).
KAKAO_REST_API_KEY=""

# 관리자 부트스트랩: 이 목록에 있는 이메일로 로그인하면 자동으로 ADMIN 권한이 부여됩니다.
# 쉼표로 여러 개 지정 가능. 별도 관리자 초대 기능이 생기기 전까지의 임시 방편입니다.
ADMIN_EMAILS=""

# 테스트 로그인 (내부 QA 전용): 값을 설정하면 웹의 /dev-login, 모바일 앱의
# "테스트 계정으로 로그인"에서 이 비밀값 + 역할(고객/업체/관리자)만으로 실제
# 카카오/구글/네이버 계정 없이 로그인할 수 있는 고정 테스트 계정이 생성됩니다.
# 비워두면 기능 자체가 완전히 꺼집니다. 배포(Vercel)에서 써도 되지만, 이 값을
# 아는 사람은 누구나 테스트 계정으로 로그인할 수 있으니 openssl rand -hex 32
# 같은 걸로 추측 불가능한 값을 쓰고 아무에게도 공유하지 마세요.
TEST_LOGIN_SECRET=""

# Cloudinary (업체·리뷰 사진 저장) — https://cloudinary.com 가입 후
# Dashboard 첫 화면에서 바로 확인 가능. 로컬/배포에서 같은 계정을 공유해도
# 무방합니다 (로컬 테스트 업로드도 실제 Cloudinary 계정에 올라간다는 점만 유의).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
